# ========================================================================
# ENVIRONMENT CONFIGURATION - Copy to .env or .env.production
# ========================================================================

# Server Configuration
NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Database Configuration - MySQL/MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=plumtek_admin
DB_PASSWORD=secure_password_here
DB_NAME=plumtek_catalog
DB_SSL=false

# JWT Configuration
ADMIN_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ADMIN_JWT_EXPIRY=604800000

# Admin User (for seeding)
ADMIN_EMAIL=admin@plumtek.com
ADMIN_PASSWORD=admin123

# Security Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,https://yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REQUEST_SIZE_BYTES=1048576
API_KEY_ENABLED=false
API_KEY=optional-api-key-for-public-endpoints

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Feature Flags
SEED_DATABASE=true
ENABLE_PRODUCT_CACHE=true
CACHE_TTL_MINUTES=30
