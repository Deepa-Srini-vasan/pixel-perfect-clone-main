# ========================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================================

# Server Configuration
NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Database Configuration - MySQL/MariaDB (XAMPP Defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=plumtek
DB_PASSWORD=TNZcmzZhXTseRY8B
DB_NAME=plumtek
DB_SSL=false

# JWT Configuration (Change these values!)
ADMIN_JWT_SECRET=your-production-jwt-secret-key-minimum-32-characters
ADMIN_JWT_EXPIRY=604800000

# Admin User (for seeding - disable in production after first run)
ADMIN_EMAIL=admin@plumtek.com
ADMIN_PASSWORD=your-secure-password

# Security Configuration
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REQUEST_SIZE_BYTES=1048576
API_KEY_ENABLED=false
API_KEY=

# Logging Configuration
LOG_LEVEL=warn
LOG_FILE=/var/log/plumtek/app.log

# Feature Flags
SEED_DATABASE=true
ENABLE_PRODUCT_CACHE=true
CACHE_TTL_MINUTES=60

# Email Configuration (for career applications & notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-production-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=careers@plumtek.com
HR_EMAIL=hr@plumtek.com

# Frontend Analytics
# Set this to your Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
VITE_GA_MEASUREMENT_ID=

# Canonical site URL for SEO and social sharing. Use the consolidated production domain here.
VITE_SITE_URL=https://plumtek.wsplcloud.com
