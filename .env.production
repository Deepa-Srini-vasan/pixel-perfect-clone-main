# ========================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================================

# Server Configuration
NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Database Configuration - Local MySQL/MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plumtek_catalog
DB_SSL=false

# JWT Configuration (Change these values!)
ADMIN_JWT_SECRET=your-production-jwt-secret-key-minimum-32-characters
ADMIN_JWT_EXPIRY=604800000

# Admin User (for seeding - disable in production after first run)
ADMIN_EMAIL=admin@plumtek.com
ADMIN_PASSWORD=your-secure-password

# Security Configuration
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REQUEST_SIZE_BYTES=1048576
API_KEY_ENABLED=false
API_KEY=

# Logging Configuration
LOG_LEVEL=warn
LOG_FILE=/var/log/plumtek/app.log

# Feature Flags
SEED_DATABASE=true
ENABLE_PRODUCT_CACHE=true
CACHE_TTL_MINUTES=60
