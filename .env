# Server Configuration
NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Database Configuration - MySQL/MariaDB (XAMPP Defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plumtek_catalog
DB_SSL=false

# JWT Configuration
ADMIN_JWT_SECRET=plumtek-dev-secret-key-12345
ADMIN_JWT_EXPIRY=604800000

# Admin User (for seeding)
ADMIN_EMAIL=admin@plumtek.com
ADMIN_PASSWORD=admin123

# Security Configuration
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info

# Feature Flags
SEED_DATABASE=true
ENABLE_PRODUCT_CACHE=false
